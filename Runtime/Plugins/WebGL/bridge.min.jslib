"use strict";

function ACLoadCore() {
  var coreScriptId = "appcharge-core-v2-loader";
  var coreScriptSrc = "https://ac-public-apks-test.s3.us-east-1.amazonaws.com/core-v2.min.js";

  var script = document.createElement("script");
  script.id = coreScriptId;
  script.src = coreScriptSrc;

  script.onerror = function () {
    console.error("Failed to load corev2.min.js");
  };

  document.head.appendChild(script);
}

function ACInit(sdkVersion, checkoutPublicKey) {
  if (typeof window !== "undefined" && window.ACInit) {
    window.ACInit(SendMessage, UTF8ToString(sdkVersion), UTF8ToString(checkoutPublicKey));
  } else {
    console.error("ACInit is not defined on window");
  }
}

function ACOpenCheckout(purchaseId, parsedUrl) {
  if (typeof window !== "undefined" && window.ACOpenCheckout) {
    window.ACOpenCheckout(
      UTF8ToString(purchaseId),
      UTF8ToString(parsedUrl)
    );
  } else {
    console.error("ACOpenCheckout is not defined on window");
  }
}

function ACOpenCheckoutLegacy(sessionUrl, sessionToken, purchaseId) {
  if (typeof window !== "undefined" && window.ACOpenCheckoutLegacy) {
    window.ACOpenCheckoutLegacy(
      UTF8ToString(sessionUrl),
      UTF8ToString(sessionToken),
      UTF8ToString(purchaseId)
    );
  } else {
    console.error("ACOpenCheckout is not defined on window");
  }
}

function ACGetPricePoints() {
  if (typeof window !== "undefined" && window.ACGetPricePoints) {
    window.ACGetPricePoints();
  } else {
    console.error("ACGetPricePoints is not defined on window");
  }
}

mergeInto(LibraryManager.library, {
  AC_LoadCore: ACLoadCore,
  AC_Init: ACInit,
  AC_OpenCheckoutLegacy: ACOpenCheckoutLegacy,
  AC_OpenCheckout: ACOpenCheckout,
  AC_GetPricePoints: ACGetPricePoints,
});