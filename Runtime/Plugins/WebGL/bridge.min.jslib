"use strict";

function ACLoadCore() {
  var coreScriptId = "appcharge-core-v3-loader";
  var coreScriptSrc = "https://ac-public-apks-test.s3.us-east-1.amazonaws.com/core-v3.min.js";

  var script = document.createElement("script");
  script.id = coreScriptId;
  script.src = coreScriptSrc;

  script.onerror = function () {
    console.error("Failed to load core-v3.min.js");
  };

  document.head.appendChild(script);
}

function ACInit(sdkVersion) {
  if (typeof window !== "undefined" && window.ACInit) {
    window.ACInit(SendMessage, UTF8ToString(sdkVersion));
  } else {
    console.error("ACInit is not defined on window");
  }
}

function ACOpenCheckout(purchaseId, parsedUrl, customerId) {
  if (typeof window !== "undefined" && window.ACOpenCheckout) {
    window.ACOpenCheckout(
      UTF8ToString(purchaseId),
      UTF8ToString(parsedUrl),
      UTF8ToString(customerId)
    );
  } else {
    console.error("ACOpenCheckout is not defined on window");
  }
}

mergeInto(LibraryManager.library, {
  AC_LoadCore: ACLoadCore,
  AC_Init: ACInit,
  AC_OpenCheckout: ACOpenCheckout,
});