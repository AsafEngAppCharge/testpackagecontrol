"use strict";

mergeInto(LibraryManager.library, {
  AC_Init: function (sdkVersion, coreScriptSrc) {
    var version = UTF8ToString(sdkVersion);
    var src = UTF8ToString(coreScriptSrc);
    var coreScriptId = "appcharge-core-v3-loader";

    var existing = document.getElementById(coreScriptId);
    if (
      existing &&
      existing.getAttribute("src") === src &&
      typeof window.ACInit === "function"
    ) {
      window.ACInit(SendMessage, version);
      return;
    }

    if (existing) {
      existing.remove();
    }

    var previousListener = window.__appchargeCoreMessageListener;
    if (typeof previousListener === "function") {
      window.removeEventListener("message", previousListener);
    }
    delete window.__appchargeCoreMessageListener;
    delete window.ACInit;
    delete window.ACOpenCheckout;
    delete window.__appchargeLoadCore;

    var script = document.createElement("script");
    script.id = coreScriptId;
    script.src = src;

    script.onerror = function () {
      console.error("Failed to load unity-webgl-core.js from " + src);
    };

    script.onload = function () {
      if (typeof window.ACInit === "function") {
        window.ACInit(SendMessage, version);
      } else {
        console.error("ACInit is not defined on window");
      }
    };

    document.head.appendChild(script);
  },

  AC_OpenCheckout: function (purchaseId, parsedUrl, customerId) {
    if (typeof window.ACOpenCheckout === "function") {
      window.ACOpenCheckout(
        UTF8ToString(purchaseId),
        UTF8ToString(parsedUrl),
        UTF8ToString(customerId)
      );
    } else {
      console.error("ACOpenCheckout is not defined on window");
    }
  },
});
